{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "rootDir": "./webapp",
    "baseUrl": "./webapp",
    "paths": {
      "e2e/real/ts/*": ["./*"]
    },
    "composite": true,
    "types": ["@openui5/types", "@types/qunit"]
  },
  "include": ["./webapp/**/*"]
}
